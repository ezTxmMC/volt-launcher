{
  "name": "volt-launcher-app",
  "version": "0.1.2",
  "homepage": "https://github.com/Volt-Launcher/volt-launcher",
  "description": "Volt Launcher - Electron frontend",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Volt Launcher",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "package": "pnpm build && node scripts/package.mjs",
    "publish:cdn": "node scripts/publish-cdn.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@iconify-json/lucide": "^1.2.142",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "skinview3d": "^3.4.2"
  }
}
