{
  "name": "voltlauncher-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "electron:build": "vite build && electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "app.voltlauncher",
    "productName": "VoltLauncher",
    "directories": {
      "output": "../volt-app/src/main/resources/electron-bin",
      "buildResources": "icons"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "icon": "icon.icns"
    },
    "win": {
      "target": "dir",
      "icon": "icon.ico"
    },
    "linux": {
      "target": "dir",
      "icon": "icon.png"
    }
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@volt-launcher/volt-ui": "^0.1.1",
    "dompurify": "^3.4.0",
    "marked": "^17.0.6",
    "skinview3d": "^3.4.1",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.0.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.19.17",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-oxlint": "~1.11.2",
    "eslint-plugin-vue": "~10.4.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.11.2",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.8",
    "vite-plugin-inspect": "12.0.0-beta.1",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6",
    "wait-on": "^9.0.5"
  }
}
