<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>app.voltlauncher</groupId>
    <artifactId>volt-launcher-parent</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>

    <name>VoltLauncher</name>
    <description>Modular Minecraft launcher with multi-loader and multi-provider support</description>

    <modules>
        <module>volt-core</module>
        <module>volt-auth</module>
        <module>volt-game</module>
        <module>volt-providers</module>
        <module>volt-server</module>
        <module>volt-app</module>
        <module>volt-setup</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <org.json.version>20250517</org.json.version>
        <javalin.version>7.1.0</javalin.version>
        <slf4j.version>2.0.16</slf4j.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>app.voltlauncher</groupId>
                <artifactId>volt-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.voltlauncher</groupId>
                <artifactId>volt-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.voltlauncher</groupId>
                <artifactId>volt-game</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.voltlauncher</groupId>
                <artifactId>volt-providers</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.voltlauncher</groupId>
                <artifactId>volt-server</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Third party -->
            <dependency>
                <groupId>org.json</groupId>
                <artifactId>json</artifactId>
                <version>${org.json.version}</version>
            </dependency>
            <dependency>
                <groupId>io.javalin</groupId>
                <artifactId>javalin</artifactId>
                <version>${javalin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Bound explicitly so the managed version is used rather than whatever the running
                 Maven happens to default to; older Surefire releases do not discover JUnit 5. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <compilerArgs>
                            <arg>-Xlint:unchecked</arg>
                            <arg>-Xlint:deprecation</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
