package launch

import os
import thread
import time
import core

// Child processes with a handle.
//
// The Novus runtime (alpha.8) can only run commands to completion:
// os.exec = system(), os.output/os.run = popen()+pclose(). None of them
// returns a pid or lets the program wait for, poll or signal a process it
// started, so a game (or the Forge installer, which runs for minutes and must
// stay cancellable) cannot be tracked with them. These C blocks add what is
// missing:
//
//   unix:    fork(), then in the child setsid(), chdir(), stdout+stderr
//            appended to the log file, stdin from /dev/null, every inherited
//            descriptor >= 3 closed (the backend's sockets must not leak into
//            the game), execv/execvp. A close-on-exec pipe reports a failed
//            chdir/exec back to the parent, so "java not found" is an error
//            of the launch, not an exit code 127 later. waitpid() for the exit
//            code (EINTR from the collector's stop signals is retried),
//            kill() of the process group for stop.
//   Windows: CreateProcess with inheritable log handles, WaitForSingleObject,
//            GetExitCodeProcess, TerminateProcess. Written for completeness,
//            NOT compiled or run (no Windows toolchain here).

c {
#ifdef _WIN32
#include <windows.h>
#define VOLT_LAUNCH_SLOTS 64
    static long long volt_launch_pids[VOLT_LAUNCH_SLOTS];
    static HANDLE volt_launch_handles[VOLT_LAUNCH_SLOTS];

    static HANDLE volt_launch_handle(long long pid) {
        int i;
        for (i = 0; i < VOLT_LAUNCH_SLOTS; i++) {
            if (volt_launch_pids[i] == pid) return volt_launch_handles[i];
        }
        return NULL;
    }

    static void volt_launch_forget(long long pid) {
        int i;
        for (i = 0; i < VOLT_LAUNCH_SLOTS; i++) {
            if (volt_launch_pids[i] == pid) {
                CloseHandle(volt_launch_handles[i]);
                volt_launch_pids[i] = 0;
                volt_launch_handles[i] = NULL;
            }
        }
    }

    /* One argument quoted for CommandLineToArgvW / the MSVC runtime. */
    static void volt_launch_quote(NvSb *sb, const char *arg) {
        int needs = (*arg == 0) || strpbrk(arg, " \t\"") != NULL;
        const char *p;
        if (!needs) { nv_sb_add(sb, arg); return; }
        nv_sb_add(sb, "\"");
        for (p = arg; ; p++) {
            int slashes = 0;
            while (*p == '\\') { slashes++; p++; }
            if (*p == 0) { while (slashes-- > 0) nv_sb_add(sb, "\\\\"); break; }
            if (*p == '"') { while (slashes-- > 0) nv_sb_add(sb, "\\\\"); nv_sb_add(sb, "\\\""); continue; }
            while (slashes-- > 0) nv_sb_add(sb, "\\");
            nv_sb_addn(sb, p, 1);
        }
        nv_sb_add(sb, "\"");
    }

    /* The environment block of the child: the given "NAME=value" entries, then every
       inherited variable whose name they do not set (CreateProcess wants one block). */
    static char *volt_launch_env_block(nv environment) {
        size_t n = (size_t)environment->a->len, i, pos = 0, total = 2;
        char *inherited = GetEnvironmentStringsA();
        const char *p;
        char *block;
        for (i = 0; i < n; i++) total += strlen(nv_cstr(environment->a->items[i])) + 1;
        for (p = inherited; *p; p += strlen(p) + 1) total += strlen(p) + 1;
        block = (char *)malloc(total);
        for (i = 0; i < n; i++) {
            const char *e = nv_cstr(environment->a->items[i]);
            size_t l = strlen(e);
            memcpy(block + pos, e, l + 1);
            pos += l + 1;
        }
        for (p = inherited; *p; p += strlen(p) + 1) {
            const char *eq = strchr(p, '=');
            size_t nl = (eq && eq != p) ? (size_t)(eq - p) : strlen(p);
            size_t j;
            int overridden = 0;
            for (j = 0; j < n && !overridden; j++) {
                const char *v = nv_cstr(environment->a->items[j]);
                const char *veq = strchr(v, '=');
                size_t vl = veq ? (size_t)(veq - v) : strlen(v);
                if (vl == nl && _strnicmp(v, p, nl) == 0) overridden = 1;
            }
            if (!overridden) {
                size_t l = strlen(p);
                memcpy(block + pos, p, l + 1);
                pos += l + 1;
            }
        }
        block[pos] = 0;
        FreeEnvironmentStringsA(inherited);
        return block;
    }

    static long long volt_launch_spawn(nv argv, nv environment, const char *cwd, const char *logFile, char *err, int errLen) {
        NvSb sb;
        int i, slot = -1;
        SECURITY_ATTRIBUTES sa;
        STARTUPINFOA si;
        PROCESS_INFORMATION pi;
        HANDLE logHandle;
        char *line;
        char *envBlock = NULL;
        nv_sb_init(&sb);
        for (i = 0; i < argv->a->len; i++) {
            if (i > 0) nv_sb_add(&sb, " ");
            volt_launch_quote(&sb, nv_cstr(argv->a->items[i]));
        }
        line = nv_sb_finish(&sb);
        for (i = 0; i < VOLT_LAUNCH_SLOTS; i++) if (volt_launch_pids[i] == 0) { slot = i; break; }
        if (slot < 0) { snprintf(err, errLen, "too many child processes"); return -1; }
        memset(&sa, 0, sizeof(sa));
        sa.nLength = sizeof(sa);
        sa.bInheritHandle = TRUE;
        logHandle = CreateFileA(logFile, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
        if (logHandle == INVALID_HANDLE_VALUE) { snprintf(err, errLen, "cannot open %s (error %lu)", logFile, GetLastError()); return -1; }
        memset(&si, 0, sizeof(si));
        si.cb = sizeof(si);
        si.dwFlags = STARTF_USESTDHANDLES;
        si.hStdInput = NULL;
        si.hStdOutput = logHandle;
        si.hStdError = logHandle;
        memset(&pi, 0, sizeof(pi));
        envBlock = environment->a->len > 0 ? volt_launch_env_block(environment) : NULL;
        if (!CreateProcessA(NULL, line, NULL, NULL, TRUE, CREATE_NO_WINDOW | CREATE_NEW_PROCESS_GROUP, envBlock, cwd, &si, &pi)) {
            snprintf(err, errLen, "CreateProcess failed (error %lu)", GetLastError());
            CloseHandle(logHandle);
            free(envBlock);
            return -1;
        }
        free(envBlock);
        CloseHandle(logHandle);
        CloseHandle(pi.hThread);
        volt_launch_pids[slot] = (long long)pi.dwProcessId;
        volt_launch_handles[slot] = pi.hProcess;
        return (long long)pi.dwProcessId;
    }

    static long long volt_launch_wait(long long pid, int block) {
        HANDLE h = volt_launch_handle(pid);
        DWORD code = 0;
        if (h == NULL) return -1;
        if (WaitForSingleObject(h, block ? INFINITE : 0) == WAIT_TIMEOUT) return -2;
        GetExitCodeProcess(h, &code);
        volt_launch_forget(pid);
        return (long long)code;
    }

    static int volt_launch_signal(long long pid, int force) {
        HANDLE h = volt_launch_handle(pid);
        (void)force;
        if (h == NULL) return 0;
        return TerminateProcess(h, 1) ? 1 : 0;
    }
#else
#include <unistd.h>
#include <fcntl.h>
#include <signal.h>
#include <errno.h>
#include <sys/types.h>
#include <sys/wait.h>

    /* The child's environment: ours with the given "NAME=value" entries replacing
       inherited variables of the same name. Built before fork(), so the child only assigns it. */
    extern char **environ;
    static char **volt_launch_env(nv environment) {
        int n = environment->a->len, count = 0, i, k = 0;
        char **out, **e;
        for (e = environ; *e; e++) count++;
        out = (char **)malloc(sizeof(char *) * (size_t)(count + n + 1));
        for (e = environ; *e; e++) {
            const char *eq = strchr(*e, '=');
            size_t nl = eq ? (size_t)(eq - *e) : strlen(*e);
            int overridden = 0;
            for (i = 0; i < n && !overridden; i++) {
                const char *v = nv_cstr(environment->a->items[i]);
                const char *veq = strchr(v, '=');
                size_t vl = veq ? (size_t)(veq - v) : strlen(v);
                if (vl == nl && strncmp(v, *e, nl) == 0) overridden = 1;
            }
            if (!overridden) out[k++] = strdup(*e);
        }
        for (i = 0; i < n; i++) out[k++] = strdup(nv_cstr(environment->a->items[i]));
        out[k] = NULL;
        return out;
    }

    static long long volt_launch_spawn(nv argv, nv environment, const char *cwd, const char *logFile, char *err, int errLen) {
        int n = argv->a->len, i, pipefd[2], childErr = 0;
        char **args;
        char **envp = NULL;
        char *dir, *log;
        long maxfd;
        pid_t pid;
        ssize_t got;
        if (n < 1) { snprintf(err, errLen, "empty command"); return -1; }
        if (environment->a->len > 0) envp = volt_launch_env(environment);
        maxfd = sysconf(_SC_OPEN_MAX);
        if (maxfd < 0 || maxfd > 65536) maxfd = 65536;
        args = (char **)malloc(sizeof(char *) * (size_t)(n + 1));
        for (i = 0; i < n; i++) args[i] = strdup(nv_cstr(argv->a->items[i]));
        args[n] = 0;
        dir = strdup(cwd);
        log = strdup(logFile);
        if (pipe(pipefd) != 0) {
            snprintf(err, errLen, "pipe: %s", strerror(errno));
            for (i = 0; i < n; i++) free(args[i]);
            free(args); free(dir); free(log);
            if (envp) { for (i = 0; envp[i]; i++) free(envp[i]); free(envp); }
            return -1;
        }
        fcntl(pipefd[0], F_SETFD, FD_CLOEXEC);
        fcntl(pipefd[1], F_SETFD, FD_CLOEXEC);
        pid = fork();
        if (pid == 0) {
            int fd, k, e;
            setsid();
            if (chdir(dir) != 0) { e = errno; (void)!write(pipefd[1], &e, sizeof(e)); _exit(126); }
            fd = open(log, O_WRONLY | O_CREAT | O_APPEND, 0644);
            if (fd < 0) { e = errno; (void)!write(pipefd[1], &e, sizeof(e)); _exit(126); }
            dup2(fd, 1);
            dup2(fd, 2);
            k = open("/dev/null", O_RDONLY);
            if (k >= 0) dup2(k, 0);
            for (k = 3; k < maxfd; k++) if (k != pipefd[1]) close(k);
            if (envp) environ = envp;
            if (strchr(args[0], '/')) execv(args[0], args); else execvp(args[0], args);
            e = errno;
            (void)!write(pipefd[1], &e, sizeof(e));
            _exit(127);
        }
        close(pipefd[1]);
        for (i = 0; i < n; i++) free(args[i]);
        free(args); free(dir); free(log);
        if (envp) { for (i = 0; envp[i]; i++) free(envp[i]); free(envp); }
        if (pid < 0) {
            snprintf(err, errLen, "fork: %s", strerror(errno));
            close(pipefd[0]);
            return -1;
        }
        do { got = read(pipefd[0], &childErr, sizeof(childErr)); } while (got < 0 && errno == EINTR);
        close(pipefd[0]);
        if (got == (ssize_t)sizeof(childErr)) {
            int status;
            while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}
            snprintf(err, errLen, "%s", strerror(childErr));
            return -1;
        }
        return (long long)pid;
    }

    /* The exit code (128 + signal when killed), -2 while it runs (block = 0), -1 on error. */
    static long long volt_launch_wait(long long pid, int block) {
        int status = 0;
        pid_t r;
        do { r = waitpid((pid_t)pid, &status, block ? 0 : WNOHANG); } while (r < 0 && errno == EINTR);
        if (r == 0) return -2;
        if (r < 0) return -1;
        if (WIFEXITED(status)) return WEXITSTATUS(status);
        if (WIFSIGNALED(status)) return 128 + WTERMSIG(status);
        return -1;
    }

    /* SIGTERM (or SIGKILL) to the child's process group (it is a session leader). */
    static int volt_launch_signal(long long pid, int force) {
        int sig = force ? SIGKILL : SIGTERM;
        if (pid <= 0) return 0;
        if (kill(-(pid_t)pid, sig) == 0) return 1;
        return kill((pid_t)pid, sig) == 0;
    }
#endif
}

// Starts argv[0] with the arguments in `cwd`, stdout and stderr appended to
// `logFile`: {pid, error}. pid <= 0 when it could not be started.
method launchSpawn(array<string> argv, string cwd, string logFile): map<string, object> {
    return launchSpawnEnv(argv, [], cwd, logFile)
}

// As launchSpawn, with extra "NAME=value" environment entries for the child.
method launchSpawnEnv(array<string> argv, array<string> environment, string cwd, string logFile): map<string, object> {
    var pid = 0
    var error = ""
    c {
        char err[512];
        long long p;
        err[0] = 0;
        p = volt_launch_spawn($argv, $environment, nv_cstr($cwd), nv_cstr($logFile), err, (int)sizeof(err));
        $pid = nv_int(p);
        $error = nv_str(err);
    }
    return {"pid": pid, "error": error}
}

// Waits for the process: its exit code (128 + signal when killed), -1 on error.
method launchWaitPid(integer pid): integer {
    c { return nv_int(volt_launch_wait(nv_ival($pid), 1)); }
}

// -2 while the process runs, else its exit code (it is reaped then).
method launchPoll(integer pid): integer {
    c { return nv_int(volt_launch_wait(nv_ival($pid), 0)); }
}

// SIGTERM (force: SIGKILL) to the process and its group.
method launchSignal(integer pid, bool force): bool {
    c { return nv_bool(volt_launch_signal(nv_ival($pid), nv_truthy($force))); }
}

// --- running games ----------------------------------------------------------------------

final LAUNCH_EARLY_CRASH_SECONDS = 10.0
final LAUNCH_STOP_GRACE_MS = 5000

var launchGameLock = thread.mutex()
var launchGames = {}       // profileId -> {pid, startedAt, clock, stopping}
var launchLastExits = {}   // profileId -> {exitCode, crashed, endedAt, seconds}
var launchBusyProfiles = {} // profileId -> jobId of a running install/launch job

method launchIsRunning(string profileId): bool {
    var running = false
    sync (launchGameLock) {
        running = launchGames.has(profileId)
    }
    return running
}

// {running, pid, startedAt, stopping, lastExit} - the contract's three
// fields plus two extras.
method launchGameStatus(string profileId): map<string, object> {
    // phase: idle | running | stopping, or the marker of the job that holds the profile
    // (install-game, launch, verify, duplicate).
    var status = {"running": false, "pid": core.none(), "startedAt": core.none(), "stopping": false, "lastExit": core.none(), "phase": "idle"}
    sync (launchGameLock) {
        if (launchBusyProfiles.has(profileId)) {
            status["phase"] = launchBusyProfiles[profileId]
        }
        if (launchGames.has(profileId)) {
            var game = launchGames[profileId]
            status["running"] = true
            status["pid"] = game["pid"]
            status["startedAt"] = game["startedAt"]
            status["stopping"] = game["stopping"]
            status["phase"] = "running"
            if (game["stopping"] == true) {
                status["phase"] = "stopping"
            }
        }
        if (launchLastExits.has(profileId)) {
            status["lastExit"] = core.copyJson(launchLastExits[profileId])
        }
    }
    return status
}

// Marks a profile busy for a job; false when it already is (or its game runs).
method launchClaimProfile(string profileId, string marker): bool {
    var claimed = false
    sync (launchGameLock) {
        if (launchBusyProfiles.has(profileId) == false) {
            launchBusyProfiles[profileId] = marker
            claimed = true
        }
    }
    return claimed
}

method launchReleaseProfile(string profileId) {
    sync (launchGameLock) {
        launchBusyProfiles.remove(profileId)
    }
}

method launchRegisterGame(string profileId, integer pid, string startedAt) {
    sync (launchGameLock) {
        launchGames[profileId] = {"pid": pid, "startedAt": startedAt, "clock": time.clock(), "stopping": false}
        core.markGameRunning(profileId, true)
        launchLastExits.remove(profileId)
    }
}

// The profile's environment variables as "NAME=value" entries for launchSpawnEnv.
method launchEnvEntries(map<string, object> profile): array {
    var entries = []
    var vars = core.getOr(profile, "envVars", core.none())
    if (core.isMap(vars)) {
        for (key in vars) {
            if (core.isString(vars[key])) {
                entries.append(key + "=" + vars[key])
            }
        }
    }
    return entries
}

// Runs a hook (a shell command line) in `cwd` with the "NAME=value" entries set and
// its output appended to `logFile`. Returns the exit code of the shell.
method launchRunHook(string command, string cwd, string logFile, array<string> environment): integer {
    var line = ""
    if (launchIsWindows()) {
        line = "cd /d " + os.shellQuoteFor("windows", cwd) + " && "
        for (entry in environment) {
            line = line + "set " + os.shellQuoteFor("windows", entry) + " && "
        }
        line = line + "cmd /c " + os.shellQuoteFor("windows", command)
        line = line + " >> " + os.shellQuoteFor("windows", logFile) + " 2>&1"
    } else {
        line = "cd " + os.shellQuote(cwd) + " && env"
        for (entry in environment) {
            line = line + " " + os.shellQuote(entry)
        }
        line = line + " sh -c " + os.shellQuote(command)
        line = line + " >> " + os.shellQuote(logFile) + " 2>&1"
    }
    return os.exec(line)
}

// Runs the profile's postExitCommand after its game exited. A failure is only logged:
// the game is already gone.
method launchRunPostExit(map<string, object> profile, string logFile) {
    var command = core.getOr(profile, "postExitCommand", core.none())
    if (core.isString(command) == false || command == "") {
        return
    }
    launchAppendLog(logFile, "[VoltLauncher] post-exit command: " + command + "\n")
    var code = launchRunHook(command, profile["gameDir"], logFile, launchEnvEntries(profile))
    if (code != 0) {
        core.logWarn("launch: post-exit command of profile " + profile["id"] + " exited with code " + code)
        launchAppendLog(logFile, "[VoltLauncher] post-exit command exited with code " + code + "\n")
    }
}

// Runs on its own OS thread per game: waits for the exit and records it.
method launchWatch(string profileId, integer pid, string logFile) {
    var code = launchWaitPid(pid)
    var seconds = 0.0
    var stopping = false
    sync (launchGameLock) {
        if (launchGames.has(profileId) && launchGames[profileId]["pid"] == pid) {
            seconds = time.clock() - launchGames[profileId]["clock"]
            stopping = launchGames[profileId]["stopping"]
            launchGames.remove(profileId)
        }
    }
    core.markGameRunning(profileId, false)
    var crashed = code != 0 && stopping == false && seconds < LAUNCH_EARLY_CRASH_SECONDS
    sync (launchGameLock) {
        launchLastExits[profileId] = {"exitCode": code, "crashed": crashed, "endedAt": core.nowIso(), "seconds": seconds}
    }
    var line = "[VoltLauncher] " + core.nowIso() + " game exited with code " + code + " after " + seconds + " s"
    if (crashed) {
        line = line + " - crashed during startup"
        core.logWarn("launch: profile " + profileId + " (pid " + pid + ") crashed after " + seconds + " s, exit code " + code + "; see " + logFile)
    } else {
        core.logInfo("launch: profile " + profileId + " (pid " + pid + ") exited with code " + code)
    }
    launchAppendLog(logFile, line + "\n")
    core.addPlaytime(profileId, core.toInteger(seconds * 1000))
    var found = core.findProfile(profileId)
    if (core.isNull(found) == false) {
        launchRunPostExit(found, logFile)
    }
}

define class LaunchAppendTask {
    private string file: get, set
    private string text: get, set

    method run(): object {
        os.appendFile(file, text)
        return true
    }
}

method launchAppendLog(string file, string text) {
    core.runTrapped(LaunchAppendTask{file = file, text = text})
}

// SIGTERM now; SIGKILL after LAUNCH_STOP_GRACE_MS when the game is still
// there. The request returns at once (the server has one thread); the
// escalation runs on its own thread.
method launchStopGame(string profileId): map<string, object> {
    var pid = 0
    sync (launchGameLock) {
        if (launchGames.has(profileId)) {
            pid = launchGames[profileId]["pid"]
            launchGames[profileId]["stopping"] = true
        }
    }
    if (pid == 0) {
        core.conflict("the game of profile '" + profileId + "' is not running")
    }
    core.logInfo("launch: stopping profile " + profileId + " (pid " + pid + ")")
    launchSignal(pid, false)
    var waited = 0
    while (waited < 300 && launchIsRunning(profileId)) {
        thread.sleep(50)
        waited = waited + 50
    }
    if (launchIsRunning(profileId)) {
        thread launchEscalate(profileId, pid)
    }
    return launchGameStatus(profileId)
}

method launchStillPid(string profileId, integer pid): bool {
    var same = false
    sync (launchGameLock) {
        same = launchGames.has(profileId) && launchGames[profileId]["pid"] == pid
    }
    return same
}

method launchEscalate(string profileId, integer pid) {
    var waited = 300
    while (waited < LAUNCH_STOP_GRACE_MS && launchStillPid(profileId, pid)) {
        thread.sleep(100)
        waited = waited + 100
    }
    if (launchStillPid(profileId, pid)) {
        core.logWarn("launch: profile " + profileId + " (pid " + pid + ") ignored SIGTERM - killing it")
        launchSignal(pid, true)
    }
}
