package launch

import bytes
import os
import path
import zlib
import core

// Reading zip archives (jars): the central directory, stored and deflated
// entries. Used for native jars and for version.json / install_profile.json
// inside Forge and NeoForge installers. No ZIP64, no encryption, CRCs are
// not checked. The mods module has its own reader; this one is separate so
// the modules stay independent.

method launchLe16(string data, integer offset): integer {
    return bytes.u8(data, offset) + bytes.u8(data, offset + 1) * 256
}

method launchLe32(string data, integer offset): integer {
    return launchLe16(data, offset) + launchLe16(data, offset + 2) * 65536
}

// The entries of an archive: [{name, method, compressedSize, size, offset}].
// Raises (500) when the data is not a zip archive.
method launchZipList(string data): array {
    var n = bytes.size(data)
    var eocd = -1
    var i = n - 22
    var lowest = n - 22 - 65535
    if (lowest < 0) {
        lowest = 0
    }
    while (i >= lowest) {
        if (bytes.u8(data, i) == 0x50 && bytes.u8(data, i + 1) == 0x4b && bytes.u8(data, i + 2) == 5 && bytes.u8(data, i + 3) == 6) {
            eocd = i
            break
        }
        i = i - 1
    }
    if (eocd < 0) {
        core.internal("not a zip archive")
    }
    var count = launchLe16(data, eocd + 10)
    var at = launchLe32(data, eocd + 16)
    var entries = []
    var k = 0
    while (k < count) {
        if (at + 46 > n || launchLe32(data, at) != 0x02014b50) {
            core.internal("broken zip central directory")
        }
        var nameLength = launchLe16(data, at + 28)
        var extraLength = launchLe16(data, at + 30)
        var commentLength = launchLe16(data, at + 32)
        entries.append({
            "name": bytes.slice(data, at + 46, at + 46 + nameLength),
            "method": launchLe16(data, at + 10),
            "compressedSize": launchLe32(data, at + 20),
            "size": launchLe32(data, at + 24),
            "offset": launchLe32(data, at + 42)
        })
        at = at + 46 + nameLength + extraLength + commentLength
        k = k + 1
    }
    return entries
}

// The bytes of one entry (from launchZipList).
method launchZipRead(string data, map<string, object> entry): string {
    var local = entry["offset"]
    if (launchLe32(data, local) != 0x04034b50) {
        core.internal("broken zip entry '" + entry["name"] + "'")
    }
    var start = local + 30 + launchLe16(data, local + 26) + launchLe16(data, local + 28)
    var raw = bytes.slice(data, start, start + entry["compressedSize"])
    if (entry["method"] == 0) {
        return raw
    }
    if (entry["method"] != 8) {
        core.internal("zip entry '" + entry["name"] + "' uses an unsupported compression method")
    }
    // zlib.decompress wants the zlib container: a 2 byte header in front of
    // the raw deflate data (the Adler-32 trailer is not checked).
    var out = zlib.decompress(bytes.putU8(0x78) + bytes.putU8(0x9c) + raw, entry["size"] + 1)
    if (zlib.failed()) {
        core.internal("cannot inflate zip entry '" + entry["name"] + "'")
    }
    return out
}

// The entry `name` of the archive file, or null when it has none.
method launchZipEntryText(string archive, string name): object {
    var data = os.readFile(archive)
    for (entry in launchZipList(data)) {
        if (entry["name"] == name) {
            return launchZipRead(data, entry)
        }
    }
    return core.none()
}

// Extracts an archive into `target`, skipping directories and names that
// start with one of `excludes`. Entries that would land outside `target`
// (absolute names, "..") are an error. Returns the number of files written.
method launchZipExtract(string archive, string target, array excludes): integer {
    var data = os.readFile(archive)
    var root = path.normalize(path.absolute(target))
    launchEnsureDir(root)
    var written = 0
    for (entry in launchZipList(data)) {
        var name = entry["name"]
        if (name.endsWith("/")) {
            continue
        }
        var skip = false
        for (prefix in excludes) {
            if (prefix != "" && name.startsWith(prefix)) {
                skip = true
            }
        }
        if (skip) {
            continue
        }
        var clean = name.replace("\\", "/")
        if (clean.startsWith("/") || clean.contains(":")) {
            core.internal("invalid path in archive: " + name)
        }
        var out = path.normalize(path.join(root, clean))
        if (out.startsWith(root + "/") == false) {
            core.internal("invalid path in archive: " + name)
        }
        launchEnsureDir(path.dirname(out))
        os.writeFile(out, launchZipRead(data, entry))
        written = written + 1
    }
    return written
}
