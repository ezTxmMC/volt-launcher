package autoprofiles

import launch
import path
import providers
import core

// Creating the profile of one Minecraft version: the name rule, the loader build
// check and the preset mods. The background check (check.nv) and the manual
// POST /api/autoprofiles/create both come through autoCreateForVersion.
//
// The result of one version is {status, reason, profileId}:
//   created   the profile exists; reason is null or names the mods that were not installed
//   skipped   the name is taken, or the loader has no build for the version (reason says why)
//   failed    the lookup or the profile could not be made now (the checker tries again later)

// The loader build of `loader` for `minecraftVersion`. Raises 422 when the loader has no
// build for the version and 502 when the lookup fails (the launch module's lookups:
// Fabric/Quilt meta, Forge/NeoForge maven).
method autoLoaderBuild(string loader, string minecraftVersion): string {
    var dir = autoFixtureDir()
    if (dir != "") {
        return autoFixtureLoaderBuild(dir, loader, minecraftVersion)
    }
    if (loader == "forge" || loader == "neoforge") {
        return launch.launchMavenLoaderVersion(loader, minecraftVersion)
    }
    var outcome = core.runTrapped(AutoMetaBuildTask{loader = loader, minecraftVersion = minecraftVersion})
    if (outcome.failed()) {
        // The Fabric meta answers 400 and the Quilt meta 404 for a version without a build
        // (the launch module reports them as "... HTTP 400"): that is "no build", not a failure.
        var message = "" + core.decodeFailure(outcome.error())["message"]
        if (message.endsWith("HTTP 400") || message.endsWith("HTTP 404")) {
            core.fail(422, "bad_request", "no " + loader + " loader is available for Minecraft " + minecraftVersion)
        }
        core.raise(outcome.error())
    }
    return outcome.result()
}

define class AutoMetaBuildTask {
    private string loader: get, set
    private string minecraftVersion: get, set

    method run(): object {
        return launch.launchMetaLoaderVersion(loader, minecraftVersion)
    }
}

// Test fixture: loaders.json maps a loader to the versions it has a build for.
method autoFixtureLoaderBuild(string dir, string loader, string minecraftVersion): string {
    var table = core.readJsonFile(path.join(dir, "loaders.json"), {})
    if (core.isMap(table)) {
        var versions = core.getOr(table, loader, [])
        if (core.isArray(versions) && versions.contains(minecraftVersion)) {
            return "fixture-" + loader
        }
    }
    core.fail(422, "bad_request", "no " + loader + " loader is available for Minecraft " + minecraftVersion)
    return ""
}

// The mods a profile of `loader` gets from the stored list. The stored list is the Fabric
// preset until the user chooses other mods, so it does not apply to the other loaders.
method autoModsFor(string loader, array stored): array {
    if (loader == "fabric" || autoIsDefaultPreset(stored) == false) {
        return stored
    }
    return []
}

// Whether the stored list is the built-in default (the same projects in the same order).
method autoIsDefaultPreset(array stored): bool {
    var preset = core.defaultSettings()["autoProfileMods"]
    if (core.isArray(preset) == false || preset.length() != stored.length()) {
        return false
    }
    var i = 0
    while (i < stored.length()) {
        if (core.isMap(stored[i]) == false || core.isMap(preset[i]) == false) {
            return false
        }
        if (("" + core.getOr(stored[i], "projectId", "")) != ("" + core.getOr(preset[i], "projectId", ""))) {
            return false
        }
        i = i + 1
    }
    return true
}

method autoOutcome(string status, object reason, object profileId): map<string, object> {
    return {"status": status, "reason": reason, "profileId": profileId}
}

// Creates the profile for one version and returns its result. Never raises, except for a
// cancelled job (the caller's job is then cancelled).
method autoCreateForVersion(string jobId, string minecraftVersion): map<string, object> {
    var name = autoProfileName(minecraftVersion)
    if (autoNameTaken(name)) {
        return autoOutcome("skipped", "already exists: a profile named '" + name + "' is there", core.none())
    }
    if (autoClaimName(name) == false) {
        return autoOutcome("skipped", "already exists: '" + name + "' is being created", core.none())
    }
    var outcome = core.runTrapped(AutoCreateTask{jobId = jobId, minecraftVersion = minecraftVersion, profileName = name})
    autoReleaseName(name)
    if (outcome.failed()) {
        if (core.isCancelFailure(outcome.error())) {
            core.raiseCancelled()
        }
        var failure = core.decodeFailure(outcome.error())
        if (failure["status"] == 422) {
            return autoOutcome("skipped", failure["message"], core.none())
        }
        return autoOutcome("failed", failure["message"], core.none())
    }
    return outcome.result()
}

define class AutoCreateTask {
    private string jobId: get, set
    private string minecraftVersion: get, set
    private string profileName: get, set

    method run(): object {
        var loader = autoLoaderSetting()
        var stored = autoModsSetting()
        var mods = autoModsFor(loader, stored)
        var reasons = []
        if (loader != "fabric" && mods.length() == 0 && stored.length() > 0) {
            reasons.append("the Fabric preset does not apply to " + loader + "; choose mods in autoProfileMods")
        }
        // The loader must have a build for this version before a profile is made.
        autoLoaderBuild(loader, minecraftVersion)
        core.jobProgress(jobId, 0.05, "Erstelle " + profileName)
        // Every automatic profile shares the options and the server list (core/synced.nv).
        var profile = core.createProfile({"name": profileName, "minecraftVersion": minecraftVersion, "loader": loader, "synced": ["options", "servers"]})
        var profileId = "" + profile["id"]
        core.logInfo("autoprofiles: created '" + profileName + "' (" + loader + ")")
        for (note in autoInstallPreset(jobId, profileId, mods)) {
            reasons.append(note)
        }
        var reason = core.none()
        if (reasons.length() > 0) {
            reason = reasons.join("; ")
        }
        return autoOutcome("created", reason, profileId)
    }
}

// Installs the preset mods into the profile. A mod that cannot be installed is noted and
// skipped and does not fail the profile; only a cancel gets through.
method autoInstallPreset(string jobId, string profileId, array mods): array {
    if (mods.length() == 0) {
        return []
    }
    providers.claimBusy(profileId, "autoprofile")
    var outcome = core.runTrapped(AutoModsTask{jobId = jobId, profileId = profileId, mods = mods})
    providers.releaseBusy(profileId)
    if (outcome.failed()) {
        core.raise(outcome.error())
    }
    return outcome.result()
}

define class AutoModsTask {
    private string jobId: get, set
    private string profileId: get, set
    private array mods: get, set

    // The notes of the mods that were not installed.
    method run(): object {
        var notes = []
        var total = mods.length()
        var done = 0
        for (entry in mods) {
            var projectId = "" + core.getOr(entry, "projectId", "")
            var label = "" + core.getOr(entry, "name", "")
            if (label == "") {
                label = projectId
            }
            core.jobProgress(jobId, 0.1 + 0.8 * done / total, "Installiere " + label)
            var step = core.runTrapped(AutoModTask{
                jobId = jobId, profileId = profileId,
                provider = "" + core.getOr(entry, "provider", "modrinth"), projectId = projectId
            })
            if (step.failed()) {
                if (core.isCancelFailure(step.error())) {
                    core.raiseCancelled()
                }
                var message = "" + core.decodeFailure(step.error())["message"]
                notes.append(label + " not installed: " + message)
            }
            done = done + 1
        }
        return notes
    }
}

// One mod: the newest version that fits the profile, its required dependencies included.
define class AutoModTask {
    private string jobId: get, set
    private string profileId: get, set
    private string provider: get, set
    private string projectId: get, set

    method run(): object {
        return providers.installContent(jobId, profileId, provider, projectId, "", "mod", true, "")
    }
}

// POST /api/autoprofiles/create: the job for one version (the route checked the version and the name).
define class AutoProfileCreateJob based JobBody {
    private string minecraftVersion: get, set

    method execute(string jobId): object {
        var result = autoCreateForVersion(jobId, minecraftVersion)
        autoRecordResult(minecraftVersion, result)
        if (result["status"] == "failed") {
            core.internal("" + result["reason"])
        }
        autoMarkSeen(minecraftVersion)
        autoSaveNow()
        return result
    }
}
