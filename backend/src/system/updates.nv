package system

import base64
import bytes
import core
import crypto
import json
import launch
import os
import path
import strings
import thread
import time

// Launcher updates from GitHub releases (a latest.json manifest in Lumen IDE's format, written by
// app/scripts/make-manifest.mjs and uploaded with the installers). The installer for this
// platform is downloaded into <dataDir>/updates and checked against the manifest; the app
// applies it (app/src/main/updater.ts).
//
//   GET  /api/updates[?force=1]        UpdateInfo, cached for 10 minutes unless forced
//   POST /api/updates/download         [{kind: installer|deb|rpm}] Job (202) -> result {path, fileName, directory, verified}
//   POST /api/updates/open-release     {url} of the release page
//
// The manifest (SYSTEM_UPDATE_MANIFEST_URL, fixed) reads:
//   {product, version, releaseDate, notes?, platforms: {<platform>: {version, releaseDate,
//    update: {name, size, sha512}, files: [{name, size, sha512}]}}}
// sha512 is base64 (electron-builder style). The platform keys are the ones Lumen uses:
//   linux_amd64, linux_aarch64, windows_x86_64, windows_arm64, macos_arm64.
// The installer is platforms.<platform>.update, or the first of files when there is none. Its
// file lies at <feed>/<name> (flat, the feed is the release's download address).
//
// Verification: the downloaded file must have the manifest's size and SHA-512. The base64 value
// is decoded to 64 bytes and compared as hex with the hex digest of the file (sha512sum,
// shasum -a 512 or certutil, through launch.launchFileDigest). A failed check deletes the
// download and the job fails. Versions compare like Lumen's compareVersions (see below).
//
// UpdateInfo: {available, currentVersion, latestVersion, name, notes, publishedAt, releaseUrl,
// assetName, downloadable, assetSize, prerelease, channel ("stable" | "dev"), assets, reason,
// checksumSha512 (hex)}. With beta updates on, the rolling "dev" pre-release of the latest master build
// (SYSTEM_DEV_MANIFEST_URL, the same manifest format, files flat next to it) is checked too and the
// higher version wins.

final SYSTEM_UPDATE_CACHE_SECONDS = 600
final SYSTEM_UPDATE_ATTEMPTS = 3
// Stable: the latest (non-pre-release) GitHub release. Its files lie flat next to latest.json, which
// the release workflow uploads with the installers.
final SYSTEM_UPDATE_MANIFEST_URL = "https://github.com/ezTxmMC/volt-launcher/releases/latest/download/latest.json"
final SYSTEM_UPDATE_FEED = "https://github.com/ezTxmMC/volt-launcher/releases/latest/download"
final SYSTEM_UPDATE_RELEASE_PAGE = "https://github.com/ezTxmMC/volt-launcher/releases/latest"
// The dev channel: the rolling GitHub pre-release "dev" of the latest master build. The CI replaces it
// after every successful run; its files lie flat next to latest.json (no platform folder).
final SYSTEM_DEV_MANIFEST_URL = "https://github.com/ezTxmMC/volt-launcher/releases/download/dev/latest.json"
final SYSTEM_DEV_FEED = "https://github.com/ezTxmMC/volt-launcher/releases/download/dev"
final SYSTEM_DEV_RELEASE_PAGE = "https://github.com/ezTxmMC/volt-launcher/releases/tag/dev"
final SYSTEM_NAME_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-"
final SYSTEM_URL_SAFE = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.!~*'()"

var systemUpdateLock = thread.mutex()
var systemUpdateCache = {}       // the last UpdateInfo, with downloadUrl
var systemUpdateCachedAt = 0     // unix seconds of that check

// --- platforms ------------------------------------------------------------------

// The manifest key of a launch.launchOsName() ("linux" | "windows" | "osx") and
// launch.launchArch() ("amd64" | "aarch64" | ...) pair, or "" for a platform without a build.
method systemPlatformFor(string system, string arch): string {
    if (system == "linux" && arch == "amd64") {
        return "linux_amd64"
    }
    if (system == "linux" && arch == "aarch64") {
        return "linux_aarch64"
    }
    if (system == "windows" && arch == "amd64") {
        return "windows_x86_64"
    }
    if (system == "windows" && arch == "aarch64") {
        return "windows_arm64"
    }
    if (system == "osx" && arch == "aarch64") {
        return "macos_arm64"
    }
    return ""
}

// The manifest key of this machine, or "".
method systemPlatformKey(): string {
    return systemPlatformFor(launch.launchOsName(), launch.launchArch())
}

// --- versions (Lumen's compareVersions) -------------------------------------------

// The version without a leading "v".
method systemVersionText(string value): string {
    if (value.startsWith("v")) {
        return value.substring(1, value.length())
    }
    return value
}

// The part before the first "-".
method systemVersionCore(string text): string {
    var dash = text.indexOf("-")
    if (dash < 0) {
        return text
    }
    return text.substring(0, dash)
}

// The pre-release part: between the first and the second "-" (as JavaScript's split("-", 2)).
method systemVersionPre(string text): string {
    var dash = text.indexOf("-")
    if (dash < 0) {
        return ""
    }
    var rest = text.substring(dash + 1, text.length())
    var second = rest.indexOf("-")
    if (second < 0) {
        return rest
    }
    return rest.substring(0, second)
}

// The leading digits of a part as a number, 0 when there are none (parseInt(n, 10) || 0).
method systemLeadingNumber(string text): integer {
    var digits = ""
    for (ch in text) {
        if (strings.isDigit(ch) == false) {
            break
        }
        digits = digits + ch
    }
    if (digits == "") {
        return 0
    }
    return parseInt(digits)
}

// "1.2.10" -> [1, 2, 10].
method systemVersionNumbers(string text): array {
    var numbers = []
    for (part in text.split(".")) {
        numbers.append(systemLeadingNumber("" + part))
    }
    return numbers
}

// Pre-release identifiers, compared one by one: numbers numerically, text case-insensitively
// (an approximation of localeCompare with numeric collation for labels like "beta.2").
method systemPreCompare(string a, string b): integer {
    var left = a.split(".")
    var right = b.split(".")
    var count = left.length()
    if (right.length() < count) {
        count = right.length()
    }
    var i = 0
    while (i < count) {
        var x = "" + left[i]
        var y = "" + right[i]
        if (x != y) {
            if (strings.isNumeric(x) && strings.isNumeric(y)) {
                var nx = parseInt(x)
                var ny = parseInt(y)
                if (nx != ny) {
                    if (nx > ny) {
                        return 1
                    }
                    return -1
                }
            } else {
                return strings.compare(x.toLower(), y.toLower())
            }
        }
        i = i + 1
    }
    if (left.length() == right.length()) {
        return 0
    }
    if (left.length() < right.length()) {
        return -1
    }
    return 1
}

// -1, 0 or 1: a against b. 1.2.10 > 1.2.9; a pre-release (1.3.0-beta.1) comes before its release.
method systemCompareVersions(string a, string b): integer {
    var textA = systemVersionText(a)
    var textB = systemVersionText(b)
    var left = systemVersionNumbers(systemVersionCore(textA))
    var right = systemVersionNumbers(systemVersionCore(textB))
    var count = left.length()
    if (right.length() > count) {
        count = right.length()
    }
    var i = 0
    while (i < count) {
        integer x = 0
        integer y = 0
        if (i < left.length()) {
            x = left[i]
        }
        if (i < right.length()) {
            y = right[i]
        }
        if (x != y) {
            if (x > y) {
                return 1
            }
            return -1
        }
        i = i + 1
    }
    var preA = systemVersionPre(textA)
    var preB = systemVersionPre(textB)
    if (preA == preB) {
        return 0
    }
    if (preA == "") {
        return 1
    }
    if (preB == "") {
        return -1
    }
    return systemPreCompare(preA, preB)
}

// A string field of a JSON object, or "" (null and missing fields included).
method systemText(object source, string key): string {
    var value = core.getOr(source, key, "")
    if (core.isString(value)) {
        return value
    }
    return ""
}

// --- manifest ----------------------------------------------------------------------

// The hex form of a manifest SHA-512 (base64 of 64 bytes). "" when the value is not one.
method systemSha512Hex(string encoded): string {
    var text = encoded.trim()
    if (text.length() != 88) {
        return ""
    }
    var raw = base64.decode(text)
    if (bytes.size(raw) != 64) {
        return ""
    }
    return crypto.hex(raw).toLower()
}

// The installer entry of a platform: platforms.<platform>.update, else files[0]; none when neither.
method systemUpdateFile(map<string, object> entry): object {
    var main = core.getOr(entry, "update", core.none())
    if (core.isMap(main)) {
        return main
    }
    var files = core.getOr(entry, "files", [])
    if (core.isArray(files) && files.length() > 0 && core.isMap(files[0])) {
        return files[0]
    }
    return core.none()
}

// Percent-encoding of a file name for the URL (encodeURIComponent's unreserved set).
method systemPercentEncode(string text): string {
    var out = ""
    for (ch in text) {
        if (SYSTEM_URL_SAFE.contains(ch)) {
            out = out + ch
        } else {
            out = out + "%" + crypto.hex(ch).toUpper()
        }
    }
    return out
}

method systemFileUrl(string platform, string name): string {
    return systemFileUrlFor("stable", platform, name)
}

method systemFileUrlFor(string channel, string platform, string name): string {
    if (channel == "dev") {
        return SYSTEM_DEV_FEED + "/" + systemPercentEncode(name)
    }
    return SYSTEM_UPDATE_FEED + "/" + systemPercentEncode(name)
}

// Whether `latest` is a dev build that counts as newer than `current`: a different dev build of the
// same or a later core version, when the running build is itself a pre-release. A stable build is
// only moved to a dev build of a later core version.
method systemDevNewer(string latest, string current): bool {
    var latestText = systemVersionText(latest)
    var currentText = systemVersionText(current)
    if (systemVersionPre(latestText).startsWith("dev.") == false || latestText == currentText) {
        return false
    }
    var coreOrder = systemCompareVersions(systemVersionCore(latestText), systemVersionCore(currentText))
    if (coreOrder > 0) {
        return true
    }
    return coreOrder == 0 && systemVersionPre(currentText) != ""
}

// "not available" with a reason.
method systemUpdateNone(string reason): map<string, object> {
    return {
        "available": false,
        "currentVersion": core.version(),
        "latestVersion": core.version(),
        "name": "",
        "notes": "",
        "publishedAt": "",
        "releaseUrl": SYSTEM_UPDATE_RELEASE_PAGE,
        "assetName": "",
        "downloadable": false,
        "downloadUrl": "",
        "assetSize": 0,
        "checksumSha512": "",
        "prerelease": false,
        "channel": "stable",
        "assets": [],
        "reason": reason
    }
}

// The UpdateInfo of a manifest text for one platform and the running version. Pure: the
// fetch happens in systemUpdateFetch, so the checks can run it on fixtures.
method systemUpdateFromManifest(string text, string platform, string current, bool includePre): map<string, object> {
    return systemUpdateFromManifestFor(text, platform, current, includePre, "stable")
}

// As systemUpdateFromManifest for a channel ("stable" | "dev"): the dev channel has its own file
// layout and counts a different dev build as newer (systemDevNewer).
method systemUpdateFromManifestFor(string text, string platform, string current, bool includePre, string channel): map<string, object> {
    if (json.isValid(text) == false) {
        return systemUpdateNone("The update manifest is not valid JSON.")
    }
    var manifest = json.parse(text)
    if (core.isMap(manifest) == false) {
        return systemUpdateNone("The update manifest is not an object.")
    }
    var platforms = core.getOr(manifest, "platforms", core.none())
    if (core.isMap(platforms) == false) {
        return systemUpdateNone("The update manifest has no platforms.")
    }
    var entry = core.getOr(platforms, platform, core.none())
    if (core.isMap(entry) == false) {
        return systemUpdateNone("No update is published for " + platform + " yet.")
    }
    var latest = systemText(entry, "version")
    if (latest == "") {
        return systemUpdateNone("The update manifest has no version for " + platform + ".")
    }
    var prerelease = systemVersionPre(systemVersionText(latest)) != ""
    var newer = systemCompareVersions(latest, current) > 0
    if (channel == "dev" && systemDevNewer(latest, current)) {
        newer = true
    }
    var available = newer
    var reason = ""
    if (newer == false) {
        available = false
        reason = "You already have the latest version."
    }
    if (newer && prerelease && includePre == false) {
        available = false
        reason = "Version " + latest + " is a pre-release. Turn on beta updates to see it."
    }
    var product = systemText(manifest, "product")
    if (product == "") {
        product = "VoltLauncher"
    }
    var published = systemText(entry, "releaseDate")
    if (published == "") {
        published = systemText(manifest, "releaseDate")
    }
    var notes = ""
    if (systemText(manifest, "version") == latest) {
        notes = systemText(manifest, "notes")
    }
    var assetName = ""
    var downloadUrl = ""
    var checksum = ""
    integer size = 0
    var pick = systemUpdateFile(entry)
    if (core.isNull(pick)) {
        if (available) {
            reason = "This release has no installer for your platform."
        }
    } else {
        assetName = systemText(pick, "name")
        checksum = systemSha512Hex(systemText(pick, "sha512"))
        var declared = core.getOr(pick, "size", 0)
        if (core.isWholeNumber(declared)) {
            size = core.toInteger(declared)
        }
        if (assetName != "" && checksum != "" && size > 0) {
            downloadUrl = systemFileUrlFor(channel, platform, assetName)
        } else if (available) {
            reason = "The manifest holds no usable size or SHA-512 for the installer."
        }
    }
    var page = SYSTEM_UPDATE_RELEASE_PAGE
    if (channel == "dev") {
        page = SYSTEM_DEV_RELEASE_PAGE
    }
    // Every file of the platform with a usable size and SHA-512 (the deb or rpm of a package install).
    var assets = []
    var listed = core.getOr(entry, "files", [])
    if (core.isArray(listed)) {
        for (file in listed) {
            if (core.isMap(file) == false) {
                continue
            }
            var fileName = systemText(file, "name")
            var fileSum = systemSha512Hex(systemText(file, "sha512"))
            var fileSize = 0
            var fileDeclared = core.getOr(file, "size", 0)
            if (core.isWholeNumber(fileDeclared)) {
                fileSize = core.toInteger(fileDeclared)
            }
            if (fileName != "" && fileSum != "" && fileSize > 0) {
                assets.append({
                    "name": fileName, "assetSize": fileSize, "checksumSha512": fileSum,
                    "downloadUrl": systemFileUrlFor(channel, platform, fileName)
                })
            }
        }
    }
    return {
        "available": available,
        "currentVersion": current,
        "latestVersion": latest,
        "name": product + " " + latest,
        "notes": notes,
        "publishedAt": published,
        "releaseUrl": page,
        "assetName": assetName,
        "downloadable": downloadUrl != "",
        "downloadUrl": downloadUrl,
        "assetSize": size,
        "checksumSha512": checksum,
        "prerelease": prerelease,
        "channel": channel,
        "assets": assets,
        "reason": reason
    }
}

// --- fetch -------------------------------------------------------------------------

// GET of the manifest: {status, body, error}. status 0 when curl got no answer; retried on
// no answer and 5xx, with the launch module's rules.
method systemFetchManifest(): map<string, object> {
    return systemFetchManifestAt(SYSTEM_UPDATE_MANIFEST_URL)
}

method systemFetchManifestAt(string url): map<string, object> {
    var temp = path.join(os.temp(), "volt-update-" + crypto.hex(crypto.random(6)) + ".json")
    var answer = {"status": 0, "body": "", "error": ""}
    var attempt = 1
    while (attempt <= SYSTEM_UPDATE_ATTEMPTS) {
        var result = launch.launchCurl(url, temp)
        var status = result["status"]
        answer = {"status": status, "body": "", "error": launch.launchDescribe(result)}
        if (status >= 200 && status < 300) {
            answer["body"] = os.readFile(temp)
        }
        if (os.isFile(temp)) {
            os.remove(temp)
        }
        if (status >= 200 && status < 300) {
            return answer
        }
        if (launch.launchRetryable(status) == false) {
            return answer
        }
        if (attempt < SYSTEM_UPDATE_ATTEMPTS) {
            thread.sleep(500 * attempt)
        }
        attempt = attempt + 1
    }
    return answer
}

// The check against the CDN. Raises only for an unexpected failure (the caller traps it).
method systemUpdateFetch(): map<string, object> {
    var platform = systemPlatformKey()
    var includePre = core.setting("betaUpdates") == true
    if (platform == "") {
        return systemUpdateNone("No launcher update is built for this platform (" + launch.launchOsName() + ", " + launch.launchArch() + ").")
    }
    var answer = systemFetchManifest()
    var status = answer["status"]
    if (status < 200 || status >= 300) {
        var none = systemUpdateNone("Could not reach the update manifest: " + answer["error"])
        if (status == 404) {
            none = systemUpdateNone("No update is published yet: " + SYSTEM_UPDATE_MANIFEST_URL + " answers HTTP 404.")
        }
        if (includePre) {
            // The stable feed may be empty or down: the dev channel still works.
            var onlyDev = systemFetchManifestAt(SYSTEM_DEV_MANIFEST_URL)
            if (onlyDev["status"] >= 200 && onlyDev["status"] < 300) {
                var devInfo = systemUpdateFromManifestFor("" + onlyDev["body"], platform, core.version(), true, "dev")
                if (core.getOr(devInfo, "available", false) == true) {
                    return devInfo
                }
            }
        }
        return none
    }
    var stable = systemUpdateFromManifest("" + answer["body"], platform, core.version(), includePre)
    if (includePre == false) {
        return stable
    }
    // Beta updates: the latest dev build counts too; the higher version wins (a release of the
    // same core version is higher than its dev builds).
    var devAnswer = systemFetchManifestAt(SYSTEM_DEV_MANIFEST_URL)
    var devStatus = devAnswer["status"]
    if (devStatus < 200 || devStatus >= 300) {
        return stable
    }
    var dev = systemUpdateFromManifestFor("" + devAnswer["body"], platform, core.version(), true, "dev")
    if (core.getOr(dev, "available", false) != true) {
        return stable
    }
    if (core.getOr(stable, "available", false) != true) {
        return dev
    }
    if (systemCompareVersions(systemText(dev, "latestVersion"), systemText(stable, "latestVersion")) > 0) {
        return dev
    }
    return stable
}

define class SystemUpdateFetchTask {
    method run(): object {
        return systemUpdateFetch()
    }
}

// The cached check, or a fresh one when `force` or the cache is older than 10 minutes.
// Never raises: an unreachable manifest is an UpdateInfo with a reason.
method systemUpdateCheck(bool force): map<string, object> {
    var now = time.now()
    var text = ""
    var cachedAt = 0
    sync (systemUpdateLock) {
        text = json.stringify(systemUpdateCache)
        cachedAt = systemUpdateCachedAt
    }
    var cached = json.parse(text)
    if (force == false && cached.has("latestVersion") && now - cachedAt < SYSTEM_UPDATE_CACHE_SECONDS) {
        return cached
    }
    var outcome = core.runTrapped(SystemUpdateFetchTask{})
    var info = {}
    if (outcome.failed()) {
        var failure = core.decodeFailure(outcome.error())
        info = systemUpdateNone("Could not check for updates: " + failure["message"])
    } else {
        info = outcome.result()
    }
    var stored = json.stringify(info)
    var copy = json.parse(stored)
    sync (systemUpdateLock) {
        systemUpdateCache = copy
        systemUpdateCachedAt = now
    }
    return json.parse(stored)
}

// The UpdateInfo as the API answers it (without the download address).
method systemUpdatePublic(map<string, object> info): map<string, object> {
    var out = json.parse(json.stringify(info))
    out.remove("downloadUrl")
    var assets = []
    for (asset in core.getOr(out, "assets", [])) {
        var copy = json.parse(json.stringify(asset))
        copy.remove("downloadUrl")
        assets.append(copy)
    }
    out["assets"] = assets
    return out
}

// --- download job -----------------------------------------------------------------

// A file name the disk accepts: other characters become "_".
method systemSafeFileName(string name): string {
    var out = ""
    for (ch in name) {
        if (SYSTEM_NAME_CHARS.contains(ch)) {
            out = out + ch
        } else {
            out = out + "_"
        }
    }
    if (out == "") {
        return "voltlauncher-update"
    }
    return out
}

// "" when `file` has the manifest's size and SHA-512 (hex). Otherwise the reason; the file and
// the target are deleted then, so a failed verification leaves no download behind.
method systemCheckDownload(string file, string target, string sha512Hex, integer size): string {
    var problem = ""
    var actualSize = os.fileSize(file)
    if (actualSize != size) {
        problem = "the file has " + actualSize + " bytes, the manifest says " + size
    } else if (launch.launchFileDigest(file, "sha512") != sha512Hex) {
        problem = "the SHA-512 does not match the manifest"
    }
    if (problem != "") {
        if (os.isFile(file)) {
            os.remove(file)
        }
        if (os.isFile(target)) {
            os.remove(target)
        }
    }
    return problem
}

// Downloads the installer into <dataDir>/updates. The body goes to a temporary file, is
// checked, then renamed over the target. Transport failures are retried; a failed check is not.
method systemDownloadUpdate(string jobId, string url, string assetName, string sha512Hex, integer size): map<string, object> {
    var dir = core.ensureDir(path.join(core.dataDir(), "updates"))
    var fileName = systemSafeFileName(assetName)
    var target = path.join(dir, fileName)
    var temp = target + ".part-" + crypto.hex(crypto.random(4))
    core.jobProgress(jobId, 0.0, "Lade " + fileName)
    var last = ""
    var attempt = 1
    while (attempt <= SYSTEM_UPDATE_ATTEMPTS) {
        var result = launch.launchCurl(url, temp)
        var status = result["status"]
        if (status >= 200 && status < 300) {
            var problem = systemCheckDownload(temp, target, sha512Hex, size)
            if (problem != "") {
                core.upstream("The download of " + fileName + " failed its check (" + problem + "); it was deleted.")
            }
            if (launch.launchReplace(temp, target) == false) {
                core.internal("cannot move the update to '" + target + "'")
            }
            core.jobProgress(jobId, 1.0, "Geladen")
            return {"path": target, "fileName": fileName, "directory": dir, "verified": true}
        }
        if (os.isFile(temp)) {
            os.remove(temp)
        }
        last = launch.launchDescribe(result)
        if (launch.launchRetryable(status) == false) {
            break
        }
        if (attempt < SYSTEM_UPDATE_ATTEMPTS) {
            thread.sleep(500 * attempt)
        }
        attempt = attempt + 1
    }
    core.upstream("The download of " + fileName + " failed: " + last)
    return {}
}

define class SystemUpdateDownload based JobBody {
    private string downloadUrl: get, set
    private string assetName: get, set
    private string checksum: get, set
    private integer size: get, set

    method execute(string jobId): object {
        return systemDownloadUpdate(jobId, downloadUrl, assetName, checksum, size)
    }
}

// --- routes -------------------------------------------------------------------------

method systemUpdatesRoute(string verb, array<string> segments, map<string, string> query, object body): map<string, object> {
    if (segments.length() == 1) {
        if (verb != "GET") {
            return core.methodNotAllowed(verb, segments)
        }
        var force = false
        if (query.has("force")) {
            force = query["force"] == "1" || query["force"] == "true"
        }
        return core.ok(systemUpdatePublic(systemUpdateCheck(force)))
    }
    if (segments.length() == 2 && segments[1] == "download") {
        if (verb != "POST") {
            return core.methodNotAllowed(verb, segments)
        }
        var info = systemUpdateCheck(false)
        if (core.getOr(info, "available", false) != true) {
            core.conflict("there is no newer release to download")
        }
        if (core.getOr(info, "downloadable", false) != true) {
            core.conflict("this release has no download for your platform")
        }
        var size = 0
        var declared = core.getOr(info, "assetSize", 0)
        if (core.isWholeNumber(declared)) {
            size = core.toInteger(declared)
        }
        var downloadUrl = systemText(info, "downloadUrl")
        var assetName = systemText(info, "assetName")
        var checksum = systemText(info, "checksumSha512")
        // {"kind": "deb" | "rpm"}: the package of that kind instead of the platform's installer.
        var kind = "installer"
        if (core.isMap(body)) {
            kind = systemText(body, "kind")
            if (kind == "") {
                kind = "installer"
            }
        }
        if (kind != "installer") {
            if (kind != "deb" && kind != "rpm") {
                core.badRequest("'kind' must be installer, deb or rpm")
            }
            var found = false
            for (asset in core.getOr(info, "assets", [])) {
                if (found == false && systemText(asset, "name").endsWith("." + kind)) {
                    found = true
                    downloadUrl = systemText(asset, "downloadUrl")
                    assetName = systemText(asset, "name")
                    checksum = systemText(asset, "checksumSha512")
                    size = core.toInteger(core.getOr(asset, "assetSize", 0))
                }
            }
            if (found == false) {
                core.conflict("this release has no ." + kind + " package for your platform")
            }
        }
        var job = core.startJob("update-download", "Lade VoltLauncher " + systemText(info, "latestVersion"), SystemUpdateDownload{
            downloadUrl = downloadUrl,
            assetName = assetName,
            checksum = checksum,
            size = size
        })
        return core.respond(202, job)
    }
    if (segments.length() == 2 && segments[1] == "open-release") {
        if (verb != "POST") {
            return core.methodNotAllowed(verb, segments)
        }
        return core.ok({"url": SYSTEM_UPDATE_RELEASE_PAGE})
    }
    core.notFound("no such endpoint")
    return {}
}
