package providers

import core
import crypto
import os

// File hashes. The algorithm is chosen by the name of the field a provider
// published the hash under - never by the length of the value, which is how
// the Java launcher ended up checking Technic's MD5 sums as SHA-1.
//
// std/crypto has SHA-1, SHA-256 and MD5; SHA-512 (Modrinth and FTB publish
// it) and the CurseForge fingerprint (MurmurHash2 over the file without
// whitespace bytes) are C blocks below.

c {
    static const unsigned long long volt_prov_sha512_k[80] = {
        0x428a2f98d728ae22ULL, 0x7137449123ef65cdULL, 0xb5c0fbcfec4d3b2fULL, 0xe9b5dba58189dbbcULL,
        0x3956c25bf348b538ULL, 0x59f111f1b605d019ULL, 0x923f82a4af194f9bULL, 0xab1c5ed5da6d8118ULL,
        0xd807aa98a3030242ULL, 0x12835b0145706fbeULL, 0x243185be4ee4b28cULL, 0x550c7dc3d5ffb4e2ULL,
        0x72be5d74f27b896fULL, 0x80deb1fe3b1696b1ULL, 0x9bdc06a725c71235ULL, 0xc19bf174cf692694ULL,
        0xe49b69c19ef14ad2ULL, 0xefbe4786384f25e3ULL, 0x0fc19dc68b8cd5b5ULL, 0x240ca1cc77ac9c65ULL,
        0x2de92c6f592b0275ULL, 0x4a7484aa6ea6e483ULL, 0x5cb0a9dcbd41fbd4ULL, 0x76f988da831153b5ULL,
        0x983e5152ee66dfabULL, 0xa831c66d2db43210ULL, 0xb00327c898fb213fULL, 0xbf597fc7beef0ee4ULL,
        0xc6e00bf33da88fc2ULL, 0xd5a79147930aa725ULL, 0x06ca6351e003826fULL, 0x142929670a0e6e70ULL,
        0x27b70a8546d22ffcULL, 0x2e1b21385c26c926ULL, 0x4d2c6dfc5ac42aedULL, 0x53380d139d95b3dfULL,
        0x650a73548baf63deULL, 0x766a0abb3c77b2a8ULL, 0x81c2c92e47edaee6ULL, 0x92722c851482353bULL,
        0xa2bfe8a14cf10364ULL, 0xa81a664bbc423001ULL, 0xc24b8b70d0f89791ULL, 0xc76c51a30654be30ULL,
        0xd192e819d6ef5218ULL, 0xd69906245565a910ULL, 0xf40e35855771202aULL, 0x106aa07032bbd1b8ULL,
        0x19a4c116b8d2d0c8ULL, 0x1e376c085141ab53ULL, 0x2748774cdf8eeb99ULL, 0x34b0bcb5e19b48a8ULL,
        0x391c0cb3c5c95a63ULL, 0x4ed8aa4ae3418acbULL, 0x5b9cca4f7763e373ULL, 0x682e6ff3d6b2b8a3ULL,
        0x748f82ee5defb2fcULL, 0x78a5636f43172f60ULL, 0x84c87814a1f0ab72ULL, 0x8cc702081a6439ecULL,
        0x90befffa23631e28ULL, 0xa4506cebde82bde9ULL, 0xbef9a3f7b2c67915ULL, 0xc67178f2e372532bULL,
        0xca273eceea26619cULL, 0xd186b8c721c0c207ULL, 0xeada7dd6cde0eb1eULL, 0xf57d4f7fee6ed178ULL,
        0x06f067aa72176fbaULL, 0x0a637dc5a2c898a6ULL, 0x113f9804bef90daeULL, 0x1b710b35131c471bULL,
        0x28db77f523047d84ULL, 0x32caab7b40c72493ULL, 0x3c9ebe0a15c9bebcULL, 0x431d67c49c100d4cULL,
        0x4cc5d4becb3e42b6ULL, 0x597f299cfc657e2aULL, 0x5fcb6fab3ad6faecULL, 0x6c44198c4a475817ULL
    };
    #define VOLT_PROV_ROTR64(x, n) (((x) >> (n)) | ((x) << (64 - (n))))
    static void volt_prov_sha512_block(unsigned long long *h, const unsigned char *p) {
        unsigned long long w[80], a, b, c, d, e, f, g, hh, t1, t2;
        int i;
        for (i = 0; i < 16; i++) {
            w[i] = ((unsigned long long)p[i * 8] << 56) | ((unsigned long long)p[i * 8 + 1] << 48)
                 | ((unsigned long long)p[i * 8 + 2] << 40) | ((unsigned long long)p[i * 8 + 3] << 32)
                 | ((unsigned long long)p[i * 8 + 4] << 24) | ((unsigned long long)p[i * 8 + 5] << 16)
                 | ((unsigned long long)p[i * 8 + 6] << 8) | (unsigned long long)p[i * 8 + 7];
        }
        for (i = 16; i < 80; i++) {
            unsigned long long s0 = VOLT_PROV_ROTR64(w[i - 15], 1) ^ VOLT_PROV_ROTR64(w[i - 15], 8) ^ (w[i - 15] >> 7);
            unsigned long long s1 = VOLT_PROV_ROTR64(w[i - 2], 19) ^ VOLT_PROV_ROTR64(w[i - 2], 61) ^ (w[i - 2] >> 6);
            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
        }
        a = h[0]; b = h[1]; c = h[2]; d = h[3]; e = h[4]; f = h[5]; g = h[6]; hh = h[7];
        for (i = 0; i < 80; i++) {
            t1 = hh + (VOLT_PROV_ROTR64(e, 14) ^ VOLT_PROV_ROTR64(e, 18) ^ VOLT_PROV_ROTR64(e, 41))
                 + ((e & f) ^ (~e & g)) + volt_prov_sha512_k[i] + w[i];
            t2 = (VOLT_PROV_ROTR64(a, 28) ^ VOLT_PROV_ROTR64(a, 34) ^ VOLT_PROV_ROTR64(a, 39))
                 + ((a & b) ^ (a & c) ^ (b & c));
            hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
        }
        h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
    }
    static nv volt_prov_sha512(nv data) {
        unsigned long long h[8] = {
            0x6a09e667f3bcc908ULL, 0xbb67ae8584caa73bULL, 0x3c6ef372fe94f82bULL, 0xa54ff53a5f1d36f1ULL,
            0x510e527fade682d1ULL, 0x9b05688c2b3e6c1fULL, 0x1f83d9abfb41bd6bULL, 0x5be0cd19137e2179ULL
        };
        unsigned char tail[256];
        unsigned char out[64];
        int len, i, rest, tailLen, full;
        const unsigned char *p = (const unsigned char *)nv_bin(data, &len);
        unsigned long long bits = (unsigned long long)len * 8ULL;
        full = len / 128;
        for (i = 0; i < full; i++) {
            volt_prov_sha512_block(h, p + (size_t)i * 128);
        }
        rest = len - full * 128;
        memset(tail, 0, sizeof(tail));
        memcpy(tail, p + (size_t)full * 128, (size_t)rest);
        tail[rest] = 0x80;
        tailLen = (rest + 1 + 16 <= 128) ? 128 : 256;
        for (i = 0; i < 8; i++) {
            tail[tailLen - 1 - i] = (unsigned char)(bits >> (8 * i));
        }
        volt_prov_sha512_block(h, tail);
        if (tailLen == 256) {
            volt_prov_sha512_block(h, tail + 128);
        }
        for (i = 0; i < 8; i++) {
            int j;
            for (j = 0; j < 8; j++) {
                out[i * 8 + j] = (unsigned char)(h[i] >> (56 - 8 * j));
            }
        }
        return nv_strn((const char *)out, 64);
    }
    /* CurseForge's file fingerprint: MurmurHash2 (seed 1) over the bytes
     * without tab, line feed, carriage return and space. */
    static nv volt_prov_cf_fingerprint(nv data) {
        int len, i, n = 0;
        const unsigned char *p = (const unsigned char *)nv_bin(data, &len);
        unsigned char *buf = (unsigned char *)malloc(len > 0 ? (size_t)len : 1);
        const unsigned int m = 0x5bd1e995u;
        unsigned int h;
        if (!buf) {
            return nv_int(0);
        }
        for (i = 0; i < len; i++) {
            unsigned char b = p[i];
            if (b == 9 || b == 10 || b == 13 || b == 32) {
                continue;
            }
            buf[n++] = b;
        }
        h = 1u ^ (unsigned int)n;
        i = 0;
        while (n - i >= 4) {
            unsigned int k = (unsigned int)buf[i] | ((unsigned int)buf[i + 1] << 8)
                           | ((unsigned int)buf[i + 2] << 16) | ((unsigned int)buf[i + 3] << 24);
            k *= m;
            k ^= k >> 24;
            k *= m;
            h *= m;
            h ^= k;
            i += 4;
        }
        switch (n - i) {
            case 3: h ^= (unsigned int)buf[i + 2] << 16; /* fall through */
            case 2: h ^= (unsigned int)buf[i + 1] << 8;  /* fall through */
            case 1: h ^= (unsigned int)buf[i]; h *= m;
            default: break;
        }
        h ^= h >> 13;
        h *= m;
        h ^= h >> 15;
        free(buf);
        return nv_int((long long)h);
    }
}

method sha512Raw(string data): string {
    c { return volt_prov_sha512($data); }
}

method cfFingerprint(string data): integer {
    c { return volt_prov_cf_fingerprint($data); }
}

method sha1Hex(string data): string {
    return crypto.hex(crypto.sha1(data))
}

// Lower case hex digest of `data` for one of sha1 | sha256 | sha512 | md5.
method digestHex(string algorithm, string data): string {
    if (algorithm == "sha1") {
        return crypto.hex(crypto.sha1(data))
    }
    if (algorithm == "sha256") {
        return crypto.hex(crypto.sha256(data))
    }
    if (algorithm == "sha512") {
        return crypto.hex(sha512Raw(data))
    }
    if (algorithm == "md5") {
        return crypto.hex(crypto.md5(data))
    }
    return ""
}

private final PV_HASH_ORDER = ["sha1", "sha256", "sha512", "md5"]

// The algorithm to check, by field name and preference: SHA-1 where present,
// then SHA-256, SHA-512, MD5. "" when no usable hash is known.
method pickHash(map<string, string> hashes): string {
    for (algorithm in PV_HASH_ORDER) {
        if (hashes.has(algorithm) && core.isString(hashes[algorithm]) && hashes[algorithm].trim() != "") {
            return algorithm
        }
    }
    return ""
}

method hasKnownHash(map<string, string> hashes): bool {
    return pickHash(hashes) != ""
}

// "" when the file matches the preferred known hash (or none is known),
// otherwise what is wrong.
method verifyFile(string file, map<string, string> hashes): string {
    var algorithm = pickHash(hashes)
    if (algorithm == "") {
        return ""
    }
    if (os.isFile(file) == false) {
        return "file is missing"
    }
    var expected = hashes[algorithm].trim().toLower()
    var actual = digestHex(algorithm, os.readFile(file))
    if (actual != expected) {
        return algorithm + " mismatch (expected " + expected + ", got " + actual + ")"
    }
    return ""
}

// A hash map from optional values (JSON null or missing become absent).
method hashMap(string sha1, string md5, string sha256, string sha512): map<string, string> {
    var out = {}
    if (sha1 != "") {
        out["sha1"] = sha1
    }
    if (md5 != "") {
        out["md5"] = md5
    }
    if (sha256 != "") {
        out["sha256"] = sha256
    }
    if (sha512 != "") {
        out["sha512"] = sha512
    }
    return out
}
