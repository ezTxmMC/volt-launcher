package logo

import core
import os
import path
import providers

// The vanilla logo: the grass block (release) or the dirt block (snapshot) texture of
// the game's own client jar, read at runtime from the user's installed game. Nothing
// from Mojang is copied into the repository or the backend's source tree.
//
// The client jar is <dataDir>/shared/versions/<mc>/<mc>.jar (the layout of launch/paths.nv).
// Without it (the game was never installed) the answer has no dataUrl.

final LOGO_TEXTURE_RELEASE = "assets/minecraft/textures/block/grass_block_side.png"
final LOGO_TEXTURE_SNAPSHOT = "assets/minecraft/textures/block/dirt.png"

define class LogoVanillaTask {
    private string minecraftVersion: get, set

    method run(): object {
        return logoVanillaDataUrl(minecraftVersion)
    }
}

// Whether a Minecraft version id names a release: two or three numeric parts, such as
// "1.21.1", "26.1" or "26.1.2". Anything else ("26w14a", "1.21.4-pre1", "1.20-rc1") is a snapshot.
method logoIsRelease(string id): bool {
    var parts = id.split(".")
    if (parts.length() < 2 || parts.length() > 3) {
        return false
    }
    for (part in parts) {
        if (logoAllDigits(part) == false) {
            return false
        }
    }
    return true
}

method logoAllDigits(string text): bool {
    if (text == "") {
        return false
    }
    for (ch in text) {
        if ("0123456789".contains(ch) == false) {
            return false
        }
    }
    return true
}

// <dataDir>/shared/versions/<mc>/<mc>.jar
method logoClientJar(string minecraftVersion): string {
    return path.join(core.dataDir(), "shared", "versions", minecraftVersion, minecraftVersion + ".jar")
}

// The texture data URL for a Minecraft version; "" when the client jar is not there or
// the texture cannot be read. The texture is cached after the first read.
method logoVanillaDataUrl(string minecraftVersion): string {
    if (logoPlainName(minecraftVersion) == false) {
        return ""
    }
    var jar = logoClientJar(minecraftVersion)
    if (os.isFile(jar) == false) {
        return ""
    }
    var release = logoIsRelease(minecraftVersion)
    var entry = LOGO_TEXTURE_SNAPSHOT
    var cacheFile = path.join(logoCacheDir(), "vanilla-dirt.png")
    if (release) {
        entry = LOGO_TEXTURE_RELEASE
        cacheFile = path.join(logoCacheDir(), "vanilla-grass.png")
    }
    if (os.isFile(cacheFile)) {
        return logoDataUrl("png", os.readFile(cacheFile))
    }
    var zip = providers.zipOpenFile(jar, "client jar " + minecraftVersion)
    var texture = providers.zipReadNamed(zip, entry)
    if (logoImageType(texture) != "png") {
        core.logWarn("logo: " + entry + " is missing in the client jar of " + minecraftVersion)
        return ""
    }
    logoEnsureCacheDir()
    var problem = core.writeFileAtomic(cacheFile, texture)
    if (problem != "") {
        core.logWarn("logo: cannot cache " + cacheFile + ": " + problem)
    }
    return logoDataUrl("png", texture)
}
